# Namecheap cPanel / Production Environment Variables
NODE_ENV=production
PORT=3200

# PostgreSQL Database Connection (Update with your cPanel PostgreSQL user, password & database name)
DATABASE_URL="postgresql://cpaneluser_dbuser:YOUR_DB_PASSWORD@localhost:5432/cpaneluser_nepal_trekking"

# Public Subdomain URL (Update with your actual Namecheap subdomain)
NEXT_PUBLIC_SITE_URL="https://trekking.codeconceptconsulting.com"

# Optional SMTP Settings for Real Outbound Emails (Namecheap PrivateEmail / cPanel Email)
# SMTP_HOST="mail.yourdomain.com"
# SMTP_PORT="465"
# SMTP_USER="info@yourdomain.com"
# SMTP_PASS="YOUR_EMAIL_PASSWORD"
